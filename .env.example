# Frontend Environment Variables Example
# Copy this to .env.local for development
# Copy this to .env.production.local for production (Vercel)

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:4444

# Application Name
VITE_APP_NAME=CarScout

# Analytics (Optional)
# VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Error Tracking (Optional)
# VITE_SENTRY_DSN=https://key@sentry.io/project
